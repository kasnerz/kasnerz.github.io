---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import SceneNav from "@/components/SceneNav.astro";
import SiteTools from "@/components/SiteTools.astro";
import { SOCIALS } from "@/constants";
import type { Lang } from "@/data/nav";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout lang={lang}>
  <div class="topbar">
    <a href={lang === "cs" ? "/cs/" : "/"} aria-label="Zdeněk Kasner">
      <img src="/logo-white.png" alt="" width="52" height="52" />
    </a>
    <SiteTools lang={lang} />
  </div>

  <main id="main-content" class="home">
    <header class="hero">
      <div class="hero-text">
        <h1>Zdeněk Kasner</h1>
        <p class="tagline">{t("home.tagline")}</p>
        <div class="socials">
          {
            SOCIALS.filter(social => !social.hideIcon).map(social => (
              <a href={social.href} title={social.linkTitle}>
                <Icon name={social.icon} aria-hidden="true" />
                <span class="sr-only">{social.linkTitle}</span>
              </a>
            ))
          }
        </div>
      </div>
      <img
        class="portrait"
        src="/profile-transparent.png"
        alt="Zdeněk Kasner"
        width="210"
        height="210"
      />
    </header>

    <SceneNav lang={lang} class="home-nav" />
  </main>
</Layout>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1rem, 4vw, 3.5rem);
    color: #fff;
  }
  .topbar img {
    width: 52px;
    height: 52px;
  }

  /* hero and figures form one block centred in the viewport; the bottom padding
     mirrors the top bar so the block sits in the middle of the screen, not below it */
  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: calc(52px + 2.5rem);
    color: #fff;
    /* the block narrows with the window like the name does, so name and photo
       don't drift apart on mid-size screens; full width from ~1370px up */
    --home-w: min(1000px, calc(60vw + 180px));
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem 4rem;
    width: 100%;
    max-width: var(--home-w);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero h1 {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2.4rem, 4.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .tagline {
    margin: 0.9rem 0 0;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.25rem, 2.3vw, 1.75rem);
    color: var(--mint);
  }
  .socials {
    display: flex;
    gap: 0.35rem;
    margin: 1.1rem 0 0 -0.35rem;
  }
  .socials a {
    display: grid;
    padding: 0.35rem;
    font-size: 1.5rem;
    color: var(--mint);
    transition: color 60ms linear;
  }
  .socials a:hover {
    color: #fff;
  }
  .portrait {
    display: block;
    width: clamp(150px, 16vw, 210px);
    height: auto;
    aspect-ratio: 1;
  }
  .home :global(.home-nav) {
    width: 100%;
    max-width: calc(var(--home-w) + 80px);
    margin: 3.5rem auto 0;
    padding: 0 1.5rem;
  }

  @media (max-width: 900px) {
    .home {
      justify-content: flex-start;
      padding-bottom: 0;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin-top: 0;
      text-align: center;
    }
    .socials {
      justify-content: center;
      margin-left: 0;
    }
    .portrait {
      order: -1;
      justify-self: center;
      width: 116px;
    }
    .home :global(.home-nav) {
      max-width: 420px;
      margin: 3.5rem auto 2.5rem;
      padding: 0 1rem;
    }
  }
</style>
