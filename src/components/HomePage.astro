---
import Layout from "@/layouts/Layout.astro";
import SceneNav from "@/components/SceneNav.astro";
import SiteTools from "@/components/SiteTools.astro";
import type { Lang } from "@/data/nav";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout lang={lang}>
  <div class="topbar">
    <a href={lang === "cs" ? "/cs/" : "/"} aria-label="Zdeněk Kasner">
      <img src="/logo-white.png" alt="" width="52" height="52" />
    </a>
    <SiteTools lang={lang} />
  </div>

  <main id="main-content" class="home">
    <header class="hero">
      <div class="hero-text">
        <h1>Zdeněk Kasner</h1>
        {
          /* hidden for now; the .tagline styles are kept below
        <p class="tagline">{t("home.tagline")}</p> */
        }
        <p class="lead">{t("home.lead")}</p>
        <a class="cta" href={lang === "cs" ? "/cs/contact" : "/contact"}>
          {t("home.cta")}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <img
        class="portrait"
        src="/profile-transparent.png"
        alt="Zdeněk Kasner"
        width="210"
        height="210"
      />
    </header>

    <section class="help-box" aria-labelledby="help-title">
      <h2 id="help-title" class="help-title">
        <span>{t("home.navIntro")}</span>
      </h2>
      <div class="help-body">
        <SceneNav lang={lang} taglines class="home-nav" />
      </div>
    </section>
  </main>
</Layout>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1rem, 4vw, 3.5rem);
    color: #fff;
  }
  .topbar img {
    width: 52px;
    height: 52px;
  }

  /* hero and figures form one block centred in the viewport; the bottom padding
     mirrors the top bar so the block sits in the middle of the screen, not below it */
  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: calc(52px + 2.5rem);
    color: #fff;
    /* the block narrows with the window like the name does, so name and photo
       don't drift apart on mid-size screens; full width from ~1400px up. The hero's
       content and the figures box below share this width, so their edges line up */
    --home-w: min(1190px, calc(60vw + 350px));
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem 4rem;
    width: 100%;
    max-width: var(--home-w);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero h1 {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2.4rem, 4.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  /* small caps drawn as letter-spaced capitals: the web font has no real small-caps glyphs;
     an L-shaped line drops from under the name's first letter and leads into the text */
  .tagline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.2rem 0 0 0.2em;
    font-weight: 600;
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .tagline::before {
    content: "";
    flex: none;
    width: 1.1rem;
    height: 1.3rem;
    margin-top: -1.1rem;
    border-left: 2px solid;
    border-bottom: 2px solid;
    border-bottom-left-radius: 4px;
    opacity: 0.7;
  }
  .lead {
    margin: 0.5rem 0 0;
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    opacity: 0.9;
    text-wrap: balance;
  }
  .cta {
    display: inline-block;
    margin-top: 1.4rem;
    padding: 0.6rem 1.25rem;
    border-radius: 10px;
    background: rgb(0 60 54 / 0.28);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.15rem;
    transition: background-color 60ms linear;
  }
  .cta:hover {
    background: rgb(0 60 54 / 0.45);
  }
  .portrait {
    display: block;
    width: clamp(150px, 16vw, 210px);
    height: auto;
    aspect-ratio: 1;
  }
  /* an outlined box around the figures, its headline set into the top edge: the
     headline row draws the top edge on either side of the text at its mid-height,
     with the rounded top corners, and the body below continues the sides and bottom */
  .help-box {
    --line: 1.5px solid rgb(209 228 217 / 0.35);
    --r: 1.1rem; /* corner radius; also half the headline's line height */
    width: calc(100% - 3rem);
    max-width: calc(
      var(--home-w) - 3rem
    ); /* the hero's width minus its padding */
    margin: 4.5rem auto 0;
  }
  .help-body {
    padding: 1.5rem clamp(1rem, 2.5vw, 2.25rem) 2rem;
    border: var(--line);
    border-top: 0;
    border-radius: 0 0 var(--r) var(--r);
  }
  .help-title {
    display: flex;
    gap: 0.8rem;
    margin: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: calc(2 * var(--r));
    color: var(--mint);
  }
  .help-title::before,
  .help-title::after {
    content: "";
    margin-top: var(--r);
    border-top: var(--line);
  }
  .help-title::before {
    flex: none;
    width: 2rem;
    border-left: var(--line);
    border-top-left-radius: var(--r);
  }
  .help-title::after {
    flex: 1;
    border-right: var(--line);
    border-top-right-radius: var(--r);
  }
  .home :global(.home-nav) {
    width: 100%;
    column-gap: clamp(0.5rem, 1.6vw, 1.5rem);
  }
  /* each figure sits on its own rounded tile that shows on hover, like the button above */
  .home :global(.home-nav .scene) {
    padding: 1.25rem 0.75rem 1.1rem;
    border-radius: 10px;
    transition:
      opacity 60ms linear,
      color 60ms linear,
      background-color 60ms linear;
  }
  .home :global(.home-nav .scene:focus-visible) {
    background: rgb(0 60 54 / 0.28);
  }
  @media (hover: hover) {
    .home :global(.home-nav .scene:hover) {
      background: rgb(0 60 54 / 0.28);
    }
  }
  .home :global(.home-nav .scene-label) {
    font-size: clamp(1.2rem, 1.9vw, 1.65rem);
  }
  /* the tagline wraps to about the label's width: inline-size containment keeps it
     from widening .scene-text, stretch gives it that width, and the negative margins
     let it run a little past the label on each side; min-width is a floor so short
     labels ("Učím") don't squeeze it into a column */
  .home :global(.scene-tagline) {
    align-self: stretch;
    contain: inline-size;
    min-width: 8.5em;
    margin-inline: -1em;
    margin-top: -0.1rem;
    font-size: clamp(0.8rem, 1vw, 0.92rem);
    font-style: italic;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .home {
      justify-content: flex-start;
      padding-bottom: 0;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin-top: 0;
      text-align: center;
    }
    /* centred under a centred name, the line would hang from mid-word */
    .tagline {
      justify-content: center;
      margin-left: 0;
    }
    .tagline::before {
      display: none;
    }
    .portrait {
      order: -1;
      justify-self: center;
      width: 116px;
    }
    .help-body {
      padding: 1rem 0.5rem 1.25rem;
    }
    .help-body :global(.scene-nav) {
      gap: 0.75rem 0.25rem;
    }
    .home :global(.home-nav .scene) {
      padding: 0.9rem 0.25rem 0.8rem;
    }
    .help-title::before {
      width: 1.25rem;
    }
    .help-box {
      width: calc(100% - 2rem);
      max-width: 440px;
      margin: 3rem auto 2.5rem;
    }
    .home :global(.home-nav .scene-label) {
      font-size: 1.25rem;
    }
    .home :global(.scene-tagline) {
      font-size: 0.8rem;
    }
  }
</style>
