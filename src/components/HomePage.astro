---
import Layout from "@/layouts/Layout.astro";
import SceneNav from "@/components/SceneNav.astro";
import SiteTools from "@/components/SiteTools.astro";
import type { Lang } from "@/data/nav";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout lang={lang}>
  <div class="topbar">
    <a href={lang === "cs" ? "/cs/" : "/"} aria-label="Zdeněk Kasner">
      <img src="/logo-white.png" alt="" width="52" height="52" />
    </a>
    <SiteTools lang={lang} />
  </div>

  <main id="main-content" class="home">
    <header class="hero">
      <div class="hero-text">
        <div class="name-row">
          {/* hidden for now; the .tagline badge styles are kept below
          <p class="tagline">{t("home.tagline")}</p> */}
          <h1>Zdeněk Kasner</h1>
        </div>
        <p class="lead">{t("home.lead")}</p>
        <a class="cta" href={lang === "cs" ? "/cs/contact" : "/contact"}>
          {t("home.cta")}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <img
        class="portrait"
        src="/profile-transparent.png"
        alt="Zdeněk Kasner"
        width="210"
        height="210"
      />
    </header>

    <section class="help-box" aria-labelledby="help-title">
      <h2 id="help-title" class="help-title">
        <span>{t("home.navIntro")}</span>
      </h2>
      <SceneNav lang={lang} taglines class="home-nav" />
    </section>
  </main>
</Layout>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1rem, 4vw, 3.5rem);
    color: #fff;
  }
  .topbar img {
    width: 52px;
    height: 52px;
  }

  /* hero and figures form one block centred in the viewport; the bottom padding
     mirrors the top bar so the block sits in the middle of the screen, not below it */
  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: calc(52px + 2.5rem);
    color: #fff;
    /* the block narrows with the window like the name does, so name and photo
       don't drift apart on mid-size screens; full width from ~1400px up. The hero's
       content and the figures box below share this width, so their edges line up */
    --home-w: min(1190px, calc(60vw + 350px));
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem 4rem;
    width: 100%;
    max-width: var(--home-w);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero h1 {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(2.4rem, 4.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  /* the tagline sits above the name as a small badge */
  .name-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: 0.9rem;
  }
  /* small caps drawn as letter-spaced capitals: the web font has no real small-caps glyphs;
     the badge uses the same dark green as the button and language switch */
  .tagline {
    margin: 0;
    padding: 0.32rem 0.45rem 0.32rem 0.58rem; /* letter-spacing trails the last letter */
    border-radius: 6px;
    background: rgb(0 60 54 / 0.28);
    line-height: 1;
    font-weight: 600;
    font-size: clamp(0.72rem, 0.9vw, 0.8rem);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .lead {
    margin: 0.5rem 0 0;
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    opacity: 0.9;
    text-wrap: balance;
  }
  .cta {
    display: inline-block;
    margin-top: 1.4rem;
    padding: 0.6rem 1.25rem;
    border-radius: 10px;
    background: rgb(0 60 54 / 0.28);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.15rem;
    transition: background-color 60ms linear;
  }
  .cta:hover {
    background: rgb(0 60 54 / 0.45);
  }
  .portrait {
    display: block;
    width: clamp(150px, 16vw, 210px);
    height: auto;
    aspect-ratio: 1;
  }
  /* the figures sit on a darker panel, its headline inside the top-left corner */
  .help-box {
    width: calc(100% - 3rem);
    max-width: calc(var(--home-w) - 3rem); /* the hero's width minus its padding */
    margin: 4.5rem auto 0;
    padding: 1.6rem clamp(1rem, 2.5vw, 2.25rem) 2.25rem;
    border-radius: 18px;
    background: rgb(0 60 54 / 0.28);
  }
  /* small caps like the badge next to the name */
  .help-title {
    margin: 0 0 1.5rem;
    font-weight: 600;
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .home :global(.home-nav) {
    width: 100%;
    column-gap: clamp(0.5rem, 1.6vw, 1.5rem);
  }
  .home :global(.home-nav .scene-label) {
    font-size: clamp(1.2rem, 1.9vw, 1.65rem);
  }
  /* the tagline wraps to about the label's width: inline-size containment keeps it
     from widening .scene-text, stretch gives it that width, and the negative margins
     let it run a little past the label on each side; min-width is a floor so short
     labels ("Učím") don't squeeze it into a column */
  .home :global(.scene-tagline) {
    align-self: stretch;
    contain: inline-size;
    min-width: 8.5em;
    margin-inline: -1em;
    margin-top: -0.1rem;
    font-size: clamp(0.8rem, 1vw, 0.92rem);
    font-style: italic;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .home {
      justify-content: flex-start;
      padding-bottom: 0;
    }
    .hero {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin-top: 0;
      text-align: center;
    }
    .name-row {
      align-items: center;
      row-gap: 0.6rem;
    }
    .portrait {
      order: -1;
      justify-self: center;
      width: 116px;
    }
    .help-box {
      width: calc(100% - 2rem);
      max-width: 440px;
      margin: 3rem auto 2.5rem;
      padding: 1.25rem 0.5rem 1.75rem;
    }
    .help-title {
      margin-bottom: 1.25rem;
      text-align: center;
    }
    .home :global(.home-nav) {
      gap: 1.75rem 0.25rem;
    }
    .home :global(.home-nav .scene-label) {
      font-size: 1.25rem;
    }
    .home :global(.scene-tagline) {
      font-size: 0.8rem;
    }
  }
</style>
