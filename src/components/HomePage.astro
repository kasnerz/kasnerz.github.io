---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import InterpolatedText from "@/components/InterpolatedText.astro";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: "en" | "cs";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const teachingHref = lang === "en" ? "/teaching" : "/cs/teaching";
const researchHref = lang === "en" ? "/research" : "/cs/research";
const projectHref = lang === "en" ? "/projects" : "/cs/projects";

// Break the tagline at sentence boundaries so it reads as a deliberate
// couplet rather than wrapping mid-clause.
const subtitleLines = t("home.subtitle").split(/(?<=\.)\s+/);
---

<Layout lang={lang}>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    class="relative app-layout flex w-full flex-1 flex-col items-center justify-center overflow-hidden py-16 sm:py-20"
  >
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="hero relative flex max-w-xl flex-col items-center text-center">
      <div class="avatar-wrap group relative">
        <img
          src="/profile.png"
          alt="Zdeněk Kasner"
          width="192"
          height="192"
          class="avatar h-36 w-36 rounded-full md:h-44 md:w-44"
        />
      </div>

      <h1
        class="mt-7 text-4xl font-bold tracking-tight text-accent sm:text-5xl dark:text-foreground"
      >
        Zdeněk Kasner
      </h1>

      <p
        class="tagline mt-3 max-w-md text-xl font-medium text-balance text-foreground sm:text-2xl"
      >
        {
          subtitleLines.map(line => (
            <span class="block">
              <InterpolatedText text={line}>
                <LinkButton
                  slot="ai"
                  icon="tabler:cpu"
                  href="https://lokalni.ai"
                  target="_blank"
                  rel="noopener"
                >
                  {t("home.link.ai")}
                </LinkButton>
              </InterpolatedText>
            </span>
          ))
        }
      </p>

      <p
        class="mt-6 max-w-md text-base leading-relaxed text-pretty text-foreground/85"
      >
        <InterpolatedText text={t("home.bio")}>
          <LinkButton
            slot="teaching"
            icon="tabler:users-group"
            href={teachingHref}
          >
            {t("home.link.teaching")}
          </LinkButton>
          <LinkButton
            slot="research"
            icon="tabler:chart-dots-3-filled"
            href={researchHref}
          >
            {t("home.link.research")}
          </LinkButton>
          <LinkButton slot="projects" icon="tabler:code" href={projectHref}>
            {t("home.link.projects")}
          </LinkButton>
        </InterpolatedText>
      </p>

      <div class="mt-9">
        <Socials />
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Soft brand glow behind the portrait — adds depth without clutter. */
  .hero-glow {
    position: absolute;
    top: 38%;
    left: 50%;
    width: min(34rem, 90vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--accent) 22%, transparent) 0%,
      transparent 68%
    );
    filter: blur(8px);
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  html[data-theme="dark"] .hero-glow {
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--accent) 22%, transparent) 0%,
      transparent 70%
    );
    opacity: 0.32;
  }

  /* Portrait: accent ring + soft lift, gentle interaction. */
  .avatar {
    object-fit: cover;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 12px 30px -12px color-mix(in oklab, var(--accent) 45%, transparent);
    outline: 2px solid color-mix(in oklab, var(--accent) 35%, transparent);
    outline-offset: 4px;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      outline-color 0.5s ease;
  }

  .avatar-wrap:hover .avatar {
    transform: translateY(-2px) scale(1.02);
    outline-color: color-mix(in oklab, var(--accent) 60%, transparent);
  }

  .tagline {
    text-wrap: balance;
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar,
    .avatar-wrap:hover .avatar {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      const backUrl = window.location.pathname.startsWith("/cs") ? "/cs/" : "/";
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
