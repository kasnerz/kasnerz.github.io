---
import { Icon } from "astro-icon/components";
import Figure from "./Figure.astro";
import SceneNav from "./SceneNav.astro";
import SiteTools from "./SiteTools.astro";
import { NAV, getNavItem, navHref, type Lang, type PageId } from "@/data/nav";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
  current?: PageId;
}

const { lang, current } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === "cs" ? "/cs/" : "/";
const currentItem = current ? getNavItem(current) : undefined;
---

<header class="site-header">
  <!-- desktop: breadcrumb on the left, the six figures and tools on the right -->
  <div class="subhead">
    <a class="crumb" href={homeHref}>
      <img
        src="/logo-white.png"
        alt=""
        width="34"
        height="34"
        class="crumb-logo"
      />
      <span class="crumb-name">Zdeněk Kasner</span>
      <span class="crumb-sep" aria-hidden="true">|</span>
      <span class="crumb-tag">{t("home.tagline")}</span>
    </a>
    {
      currentItem && (
        <span class="crumb-here">
          <span class="crumb-sep" aria-hidden="true">
            ›
          </span>
          {currentItem.label[lang]}
        </span>
      )
    }
    <nav class="minis" aria-label={t("nav.main")}>
      {
        NAV.map(item => (
          <a
            class="mini"
            href={navHref(item, lang)}
            aria-current={item.id === current ? "page" : undefined}
          >
            <Figure id={item.id} size="prop" />
            <span class="mini-label">
              {item.label[lang]}
              {item.href && (
                <Icon
                  name="tabler:arrow-up-right"
                  class="ext"
                  aria-hidden="true"
                />
              )}
            </span>
          </a>
        ))
      }
    </nav>
    <span class="subhead-divider" aria-hidden="true"></span>
    <SiteTools lang={lang} />
  </div>

  <!-- phone: name and the current page's figure, everything else behind the menu button -->
  <div class="mhead">
    <a class="mhead-home" href={homeHref}>
      <img src="/logo-white.png" alt="" width="36" height="36" />
      <span class="mhead-name">Zdeněk Kasner</span>
    </a>
    {
      current && (
        <span class="mhead-current">
          <span class="crumb-sep" aria-hidden="true">
            ›
          </span>
          <Figure id={current} size="prop" />
        </span>
      )
    }
    <button
      type="button"
      class="menu-open"
      aria-label={t("menu.open")}
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <Icon name="tabler:menu-2" />
    </button>
  </div>

  <div
    id="site-menu"
    class="menu-overlay"
    role="dialog"
    aria-modal="true"
    aria-label={t("menu.label")}
    hidden
  >
    <div class="menu-top">
      <a href={homeHref} aria-label="Zdeněk Kasner"
        ><img src="/logo-white.png" alt="" width="36" height="36" /></a
      >
      <button type="button" class="menu-close" aria-label={t("menu.close")}>
        <Icon name="tabler:x" />
      </button>
    </div>
    <SceneNav lang={lang} current={current} class="menu-nav" />
    <SiteTools lang={lang} class="menu-tools" />
  </div>
</header>

<style>
  .site-header {
    color: #fff;
  }

  .subhead {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem clamp(1rem, 3vw, 2.5rem);
  }
  .crumb {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
  }
  .crumb-logo {
    width: 34px;
    height: 34px;
  }
  .crumb-name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.3rem;
  }
  .crumb-sep {
    color: var(--mint);
    opacity: 0.7;
  }
  .crumb-tag {
    font-style: italic;
    color: var(--mint);
  }
  .crumb-here {
    display: flex;
    gap: 0.65rem;
    font-family: var(--font-head);
    font-weight: 500;
    white-space: nowrap;
  }
  .minis {
    display: flex;
    align-items: flex-end;
    gap: 0.9rem;
    margin-left: auto;
  }
  .subhead-divider {
    width: 1px;
    height: 32px;
    margin: 0 0.4rem;
    background: rgb(209 228 217 / 0.35);
  }

  .mhead,
  .menu-overlay {
    display: none;
  }

  @media (max-width: 900px) {
    .subhead {
      display: none;
    }
    .mhead {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1rem;
    }
    .mhead-home {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-width: 0;
    }
    .mhead-home img {
      width: 36px;
      height: 36px;
    }
    .mhead-name {
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 1.15rem;
      white-space: nowrap;
    }
    .mhead-current {
      --sw: 1.7;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .mhead-current :global(svg) {
      width: 24px;
      height: 24px;
      overflow: visible;
    }
    .menu-open {
      margin-left: auto;
    }
    .menu-open,
    .menu-close {
      display: grid;
      padding: 0.4rem;
      color: #fff;
      font-size: 1.6rem;
    }

    .menu-overlay:not([hidden]) {
      position: fixed;
      inset: 0;
      z-index: 50;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      background: var(--brand);
    }
    .menu-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.6rem 1rem;
    }
    .menu-top img {
      width: 36px;
      height: 36px;
    }
    /* the grid gets more air than on the front page and sits in the middle of the screen */
    .menu-overlay :global(.menu-nav) {
      margin: auto;
      row-gap: 2.75rem;
      column-gap: 1.5rem;
      padding: 0 1rem;
    }
    .menu-overlay :global(.menu-tools) {
      justify-content: center;
      padding-bottom: 2rem;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>

<script>
  // Delegated to the document, so the menu keeps working after client-side navigation
  // swaps the header out.
  function setMenuOpen(open: boolean) {
    const menu = document.querySelector<HTMLElement>("#site-menu");
    const openBtn = document.querySelector<HTMLButtonElement>(".menu-open");
    const closeBtn = document.querySelector<HTMLButtonElement>(".menu-close");
    if (!menu || !openBtn || !closeBtn || menu.hidden === !open) return;

    menu.hidden = !open;
    openBtn.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("menu-open", open);
    (open ? closeBtn : openBtn).focus();
  }

  document.addEventListener("click", e => {
    const target = e.target as Element;
    if (target.closest(".menu-open")) setMenuOpen(true);
    else if (target.closest(".menu-close")) setMenuOpen(false);
  });
  document.addEventListener("keydown", e => {
    if (e.key === "Escape") setMenuOpen(false);
  });
  // Leaving the phone layout with the menu open must not keep the page locked.
  window.matchMedia("(min-width: 901px)").addEventListener("change", e => {
    if (e.matches) setMenuOpen(false);
  });
  // A page reached from the open menu starts with it closed and scrolling unlocked.
  document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.remove("menu-open");
  });
</script>
