---
/* Billing details: trade licence, company ID linked to the public register, VAT status. */
interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;

const ICO = "06845762";

const copies = {
  en: {
    business:
      "I am a self-employed person operating under the Czech Trade Licensing Act.",
    businessId: "Company ID (IČO)",
    vat: "I am not a VAT payer.",
  },
  cs: {
    business: "Jsem fyzická osoba podnikající dle živnostenského zákona.",
    businessId: "IČO",
    vat: "Nejsem plátce DPH.",
  },
};
const copy = copies[lang];
---

<p class="business">
  {copy.business}
  {copy.businessId}:{" "}
  <a class="link" href={`https://ares.gov.cz/ekonomicke-subjekty/ros/${ICO}`}
    >{ICO}</a
  >.
  {copy.vat}
</p>

<style>
  /* sits right above the contact button */
  .business {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
  }
  .link {
    color: var(--accent-text);
    text-decoration: underline dashed;
    text-underline-offset: 4px;
  }
  .link:hover {
    color: var(--accent);
  }
</style>
