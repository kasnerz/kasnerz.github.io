---
import { Icon } from "astro-icon/components";
import { SITE } from "@/config";
import type { Lang } from "@/data/nav";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
  /** Show the contact and CV buttons before the language toggle. */
  contact?: boolean;
  class?: string;
}

const { lang, contact = false, class: className } = Astro.props;
const t = useTranslations(lang);

const contactHref = lang === "cs" ? "/cs/contact" : "/contact";
const onContact = Astro.url.pathname.replace(/\/$/, "") === contactHref;

// The toggle shows both languages with the current one highlighted; clicking it
// switches to the other one and keeps you on the same page.
const { pathname } = Astro.url;
const target: Lang = lang === "en" ? "cs" : "en";
const targetPath =
  lang === "en"
    ? `/cs${pathname === "/" ? "" : pathname}`
    : pathname.replace(/^\/cs/, "") || "/";
const targetName = target === "en" ? "English" : "Čeština";
---

<div class:list={["site-tools", className]}>
  {
    SITE.lightAndDarkMode && (
      <button
        type="button"
        class="theme-btn"
        title={t("tools.theme")}
        aria-label="auto"
        aria-live="polite"
      >
        <Icon name="tabler:moon" class="theme-icon theme-icon-moon" />
        <Icon name="tabler:sun-high" class="theme-icon theme-icon-sun" />
      </button>
    )
  }
  {
    contact && (
      <>
        <div class="tools-links">
          <a
            class="mini tools-link"
            href={contactHref}
            aria-current={onContact ? "page" : undefined}
          >
            <Icon name="mdi:message-text-outline" aria-hidden="true" />
            <span class="mini-label">{t("nav.contact")}</span>
          </a>
          <a class="mini tools-link" href="/cv.pdf" data-astro-reload>
            <Icon name="tabler:file-type-pdf" aria-hidden="true" />
            <span class="mini-label">CV</span>
          </a>
        </div>
        <span class="tools-divider" aria-hidden="true" />
      </>
    )
  }
  <a
    class="lang-toggle"
    href={targetPath}
    hreflang={target}
    lang={target}
    aria-label={targetName}
    data-lang-switch={target}
  >
    {
      (["en", "cs"] as const).map(l => (
        <span class:list={["lang-opt", { on: l === lang }]} aria-hidden="true">
          {l.toUpperCase()}
        </span>
      ))
    }
  </a>
</div>
