---
import { SMALL, LARGE, LARGE_FIT, PROPS } from "@/data/figures";
import type { PageId } from "@/data/nav";

interface Props {
  id: PageId;
  /** small: 48×48 stickman; large: header scene; prop: 24×24 object only */
  size?: "small" | "large" | "prop";
  class?: string;
}

const { id, size = "small", class: className } = Astro.props;
const art = { small: SMALL, large: LARGE, prop: PROPS }[size][id];

// Large scenes sit on the ground line (y=215) of a 240×187.5 box. A nested viewBox
// scales each one to a common height; the stroke is divided by the same factor so
// line weight stays equal. Nesting (rather than a transform) keeps the hover-animation
// pivots in the scene's own coordinates.
const W = 240;
const H = 187.5;
const fit = LARGE_FIT[id] ?? { scale: 1, cx: W / 2 };
const innerViewBox = [
  fit.cx - W / 2 / fit.scale,
  215 - H / fit.scale,
  W / fit.scale,
  H / fit.scale,
].join(" ");
---

{
  art &&
    (size === "large" ? (
      <svg
        class={className}
        viewBox={`0 0 ${W} ${H}`}
        aria-hidden="true"
        focusable="false"
      >
        <svg viewBox={innerViewBox} overflow="visible">
          <g
            class="ink"
            style={`--sw: calc(var(--big-sw, 3) / ${fit.scale})`}
            set:html={art}
          />
        </svg>
      </svg>
    ) : (
      <svg
        class={className}
        viewBox={size === "small" ? "0 0 48 48" : "0 0 24 24"}
        aria-hidden="true"
        focusable="false"
      >
        <g class="ink" set:html={art} />
      </svg>
    ))
}
