---
import { Icon } from "astro-icon/components";

interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;

// The Czech page translates from English, the English page from Czech. `<mark>` picks out
// the terms from the glossary.
const copies = {
  cs: {
    from: "Angličtina",
    to: "Čeština",
    sourceLang: "en",
    pairs: [
      [
        "Disconnect the machine from the <mark>power supply</mark> before removing the <mark>guard</mark>.",
        "Před sejmutím <mark>krytu</mark> odpojte stroj od <mark>napájení</mark>.",
      ],
      [
        "Refit the <mark>guard</mark> before restarting the machine.",
        "Před opětovným spuštěním stroje nasaďte <mark>kryt</mark> zpět.",
      ],
    ],
    glossary: "Váš slovník",
    terms: [
      ["guard", "kryt"],
      ["power supply", "napájení"],
    ],
  },
  en: {
    from: "Czech",
    to: "English",
    sourceLang: "cs",
    pairs: [
      [
        "Před sejmutím <mark>krytu</mark> odpojte stroj od <mark>napájení</mark>.",
        "Disconnect the machine from the <mark>power supply</mark> before removing the <mark>guard</mark>.",
      ],
      [
        "Před opětovným spuštěním stroje nasaďte <mark>kryt</mark> zpět.",
        "Refit the <mark>guard</mark> before restarting the machine.",
      ],
    ],
    glossary: "Your glossary",
    terms: [
      ["kryt", "guard"],
      ["napájení", "power supply"],
    ],
  },
};
const copy = copies[lang];
---

<div class="translation">
  <div class="columns">
    <p class="language">{copy.from}</p>
    <p class="language language-target">
      <Icon name="tabler:arrow-right" aria-hidden="true" />
      {copy.to}
    </p>

    {
      copy.pairs.map(([source, target], i) => (
        <>
          <p
            class="source"
            lang={copy.sourceLang}
            data-optional={i > 0 || undefined}
            set:html={source}
          />
          <p
            class="target"
            data-optional={i > 0 || undefined}
            set:html={target}
          />
        </>
      ))
    }
  </div>

  <div class="glossary">
    <span class="glossary-name">
      <Icon name="tabler:book-2" aria-hidden="true" />
      {copy.glossary}
    </span>
    {
      copy.terms.map(([source, target]) => (
        <span class="term">
          <span lang={copy.sourceLang}>{source}</span> → {target}
        </span>
      ))
    }
  </div>
</div>

<style>
  .translation {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    padding: 0.75rem 0.9rem;
  }
  .columns {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: min-content;
    gap: 0.6rem 1.75rem;
    align-content: center;
  }
  .language {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    margin: 0;
    color: var(--screen-muted);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .language :global(svg) {
    flex: none;
    width: 1.2em;
    height: 1.2em;
    color: var(--accent-text);
  }
  .source,
  .target {
    margin: 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
    font-size: 1rem;
    line-height: 1.5;
  }
  .target {
    font-weight: 500;
  }
  /* global, so it reaches the marks in the sentences (set:html) */
  .translation :global(mark) {
    padding: 0 0.2em;
    border-radius: 3px;
    background: var(--screen-mark);
    color: inherit;
    white-space: nowrap;
  }

  .glossary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
    align-items: center;
    padding-top: 0.55rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
  }
  .glossary-name {
    display: flex;
    gap: 0.3rem;
    align-items: center;
    color: var(--screen-muted);
    font-weight: 500;
  }
  .glossary-name :global(svg) {
    flex: none;
    width: 1.2em;
    height: 1.2em;
    color: var(--accent-text);
  }
  .term {
    padding: 0.05rem 0.45rem;
    border-radius: 6px;
    background: color-mix(in oklab, var(--background), var(--accent) 13%);
    font-weight: 500;
  }

  @container (max-width: 38rem) {
    .source,
    .target {
      padding-top: 0.4rem;
      font-size: 0.875rem;
      line-height: 1.4;
    }
    .columns {
      row-gap: 0.4rem;
    }
    .source[data-optional],
    .target[data-optional] {
      display: none;
    }
  }

  /* Narrow: the translation goes under its original. */
  @container (max-width: 30rem) {
    .translation {
      padding-block: 0.5rem;
    }
    .columns {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      justify-content: center;
    }
    .language {
      display: none;
    }
    .source {
      padding-top: 0;
      border-top: 0;
      color: var(--screen-muted);
    }
    .target {
      padding-top: 0.35rem;
    }
    .glossary-name {
      display: none;
    }
  }
  @container (max-width: 20rem) {
    .term:last-child {
      display: none;
    }
  }
</style>
