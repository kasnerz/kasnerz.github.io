---
import { Icon } from "astro-icon/components";

interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;

// `text` is HTML: the highlighted figures, and the parts that drop out on narrow screens.
// Each row: its label, the two quarters, and whether it is highlighted (`mark`), shown only
// on wider screens (`optional`) or kept as a spare row (`spare`).
const copies = {
  cs: {
    file: "vyroba_2026_Q3.xlsx",
    rows: [
      { label: "Tržby (mil. Kč)", q2: "116,2", q3: "126,0", mark: true },
      { label: "Prostoje L2 (h)", q2: "41", q3: "29", mark: true },
      {
        label: "Reklamace (ks)",
        q2: "38",
        q3: "44",
        mark: true,
        optional: true,
      },
      {
        label: "Zmetkovitost (%)",
        q2: "2,1",
        q3: "1,8",
        mark: true,
        optional: true,
      },
      { label: "Energie (MWh)", q2: "412", q3: "398", spare: true },
    ],
    title: "Zpráva za 3. čtvrtletí 2026",
    text: "Tržby vzrostly o&nbsp;<mark>8,4&nbsp;%</mark> na <mark>126&nbsp;mil. Kč</mark>. Prostoje linky L2 klesly ze&nbsp;<mark>41</mark> na <mark>29 hodin</mark><span data-optional> a&nbsp;zmetkovitost z&nbsp;<mark>2,1</mark> na <mark>1,8&nbsp;%</mark></span>. <span data-optional>Počet reklamací ale stoupl z&nbsp;<mark>38</mark> na <mark>44</mark>.</span>",
    legend: "Zvýrazněná čísla vycházejí z tabulky.",
  },
  en: {
    file: "production_2026_Q3.xlsx",
    rows: [
      { label: "Revenue (CZK m)", q2: "116.2", q3: "126.0", mark: true },
      { label: "L2 downtime (h)", q2: "41", q3: "29", mark: true },
      {
        label: "Complaints (pcs)",
        q2: "38",
        q3: "44",
        mark: true,
        optional: true,
      },
      {
        label: "Scrap rate (%)",
        q2: "2.1",
        q3: "1.8",
        mark: true,
        optional: true,
      },
      { label: "Energy (MWh)", q2: "412", q3: "398", spare: true },
    ],
    title: "Report for Q3 2026",
    text: "Revenue grew by <mark>8.4%</mark> to <mark>CZK&nbsp;126&nbsp;m</mark>. Downtime on line L2 fell from <mark>41</mark> to <mark>29 hours</mark><span data-optional> and the scrap rate from <mark>2.1</mark> to <mark>1.8%</mark></span>. <span data-optional>Complaints, however, rose from <mark>38</mark> to <mark>44</mark>.</span>",
    legend: "Highlighted figures come from the table.",
  },
};
const copy = copies[lang];
---

<div class="report">
  <div class="source">
    <p class="file">
      <Icon name="tabler:file-spreadsheet" aria-hidden="true" />
      {copy.file}
    </p>
    <table class="table">
      <thead>
        <tr>
          <td></td>
          <th scope="col">Q2</th>
          <th scope="col">Q3</th>
        </tr>
      </thead>
      <tbody>
        {
          copy.rows.map(row => (
            <tr
              data-optional={row.optional || undefined}
              data-spare={row.spare || undefined}
            >
              <th scope="row">{row.label}</th>
              {row.mark ? (
                <>
                  <td>
                    <mark>{row.q2}</mark>
                  </td>
                  <td>
                    <mark>{row.q3}</mark>
                  </td>
                </>
              ) : (
                <>
                  <td>{row.q2}</td>
                  <td>{row.q3}</td>
                </>
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="flow" aria-hidden="true">
    <Icon name="tabler:arrow-right" />
  </div>

  <div class="output">
    <p class="output-title">{copy.title}</p>
    <p class="text" set:html={copy.text} />
    <p class="legend" data-optional>{copy.legend}</p>
  </div>
</div>

<style>
  .report {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    column-gap: 0.75rem;
    padding: 0.75rem 0.9rem;
  }

  .file {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    margin: 0 0 0.45rem;
    color: var(--screen-muted);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .file :global(svg) {
    flex: none;
    width: 1.2em;
    height: 1.2em;
    color: var(--accent-text);
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .table th,
  .table td {
    padding: 0.32rem 0.25rem;
    border-top: 1px solid var(--border);
    font-weight: 400;
    text-align: right;
  }
  .table thead th,
  .table thead td {
    border-top: 0;
    padding-block: 0 0.2rem;
    color: var(--screen-muted);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .table tbody tr {
    height: 2.35rem;
  }
  .table tbody th {
    padding-left: 0;
    text-align: left;
  }

  /* global, so it also reaches the marks in the report's text (set:html) */
  .report :global(mark) {
    padding: 0 0.2em;
    border-radius: 3px;
    background: var(--screen-mark);
    color: inherit;
    white-space: nowrap;
  }

  .flow {
    align-self: center;
    color: color-mix(in oklab, var(--background), var(--accent) 55%);
  }
  .flow :global(svg) {
    display: block;
    width: 1.4rem;
    height: 1.4rem;
  }

  .output {
    display: flex;
    flex-direction: column;
  }
  .output-title {
    margin: 0 0 0.45rem;
    font-family: var(--font-head);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--accent-text);
  }
  .text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }
  .legend {
    margin: auto 0 0;
    color: var(--screen-muted);
    font-size: 0.8rem;
  }

  @container (max-width: 38rem) {
    .table tbody tr {
      height: auto;
    }
    .table tr[data-spare] {
      display: none;
    }
    .text {
      font-size: 0.9rem;
      line-height: 1.5;
    }
  }

  /* Narrow: the report goes under its table, and both shrink to two lines of data. */
  @container (max-width: 30rem) {
    .report {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding-block: 0.5rem;
    }
    .flow,
    .file,
    .report :global([data-optional]) {
      display: none;
    }
    .output-title {
      margin-bottom: 0.2rem;
      font-size: 1rem;
    }
    .text {
      font-size: 0.875rem;
      line-height: 1.4;
    }
  }
</style>
