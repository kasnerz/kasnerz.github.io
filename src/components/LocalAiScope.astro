---
import { Icon } from "astro-icon/components";

interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;
const en = lang === "en";

/*
 * What the assessment and the deployment deal with, one area after another. The second
 * one lays out the four ways to run AI models, from the most of the operation in Your
 * hands to the least. Their icons are line art in the stickman figures' style (48×48,
 * src/styles/figures.css).
 */
const tiers = [
  {
    title: en ? "Fully local" : "Plně lokálně",
    text: en
      ? "The models run on hardware you own, in your network. Data never leaves the building and everything works without the internet, too."
      : "Modely běží na hardwaru, který vlastníte, ve vaší síti. Data neopouštějí budovu a provoz funguje i bez internetu.",
    // a server inside a house
    icon: `
      <path d="M6 22L24 7L42 22"/>
      <path d="M10 19V42H38V19"/>
      <rect x="17" y="23" width="14" height="16" rx="1.5"/>
      <path class="thin" d="M17 28.3H31M17 33.6H31"/>
      <circle class="dot" cx="20.5" cy="25.7" r="1"/><circle class="dot" cx="20.5" cy="31" r="1"/><circle class="dot" cx="20.5" cy="36.3" r="1"/>`,
  },
  {
    title: en ? "Rented compute" : "Pronajatý výpočetní výkon",
    text: en
      ? "Open-weight models on a rented GPU server, for example in a local data center. You don't buy the hardware, but the server is yours alone."
      : "Otevřené modely na pronajatém GPU serveru, třeba v českém datacentru. Hardware nekupujete, ale server máte jen pro sebe.",
    // a server with a rental tag
    icon: `
      <rect x="6" y="8" width="20" height="32" rx="2"/>
      <path class="thin" d="M6 18.7H26M6 29.3H26"/>
      <circle class="dot" cx="10.5" cy="13.3" r="1.2"/><circle class="dot" cx="10.5" cy="24" r="1.2"/><circle class="dot" cx="10.5" cy="34.7" r="1.2"/>
      <path class="thin" d="M26 13C33 13 37 16 37 21.5"/>
      <path d="M32 20H42V31L37 36L32 31Z"/>
      <circle class="thin" cx="37" cy="24.5" r="1.6"/>`,
  },
  {
    title: en
      ? "Open-weight models, paid per token"
      : "Otevřené modely s platbou za tokeny",
    text: en
      ? "Open-weight models through a provider's API, paying only for what you use. You can switch to another provider or to your own hardware at any time."
      : "Otevřené modely přes API poskytovatele, platíte jen za spotřebu. Kdykoli můžete přejít k jinému poskytovateli nebo na vlastní hardware.",
    // a cloud fed by a coin
    icon: `
      <path d="M13 27H35A6.5 6.5 0 0 0 35.8 14.05A10 10 0 0 0 16.6 12.5A7.25 7.25 0 0 0 13 27Z"/>
      <path class="thin" d="M24 31.5V28M21 30.5L24 27.5L27 30.5"/>
      <circle cx="24" cy="39" r="6"/>
      <path class="thin" d="M24 36V42"/>`,
  },
  {
    title: en
      ? "Business plan of a commercial service"
      : "Firemní tarif komerční služby",
    text: en
      ? "Business editions of commercial services, with a data processing agreement and a guarantee that the provider won't train models on your data."
      : "Firemní verze komerčních služeb se smlouvou o zpracování dat a se zárukou, že poskytovatel na vašich datech nebude trénovat modely.",
    // a cloud and a shield with a tick
    icon: `
      <path d="M6 20H20A4.5 4.5 0 0 0 20.5 11.03A7 7 0 0 0 7.2 10.6A5 5 0 0 0 6 20Z"/>
      <path d="M34 17L44 20.5V28C44 34.5 39.5 38.7 34 41C28.5 38.7 24 34.5 24 28V20.5Z"/>
      <path class="thin" d="M29.5 28.5L32.8 31.8L38.5 25.5"/>`,
  },
];

const topics = [
  {
    id: "data",
    title: "Data",
    icon: "tabler:database",
    text: en
      ? "We go through what data you have and where it lives: documents, databases, emails, scans. I propose how to convert it into a format the models can work with, and how to keep it up to date."
      : "Projdeme, jaká data máte a kde leží: dokumenty, databáze, e-maily, skeny. Navrhnu, jak je převést do formátu, se kterým modely umí pracovat, a jak je udržovat aktuální.",
  },
  {
    id: "typy-provozu",
    title: en ? "Type of operation" : "Typ provozu",
    icon: "tabler:route",
    text: en
      ? 'AI "with guarantees" can actually take several forms. Depending on how sensitive your data is, its volume and your budget, I recommend the one that suits you best.'
      : 'AI "se zárukami" může mít ve skutečnosti několik podob. Podle citlivosti dat, jejich objemu a vašeho rozpočtu doporučím, která je pro vás nejvhodnější.',
    tiers: true,
  },
  {
    id: "modely",
    title: en ? "Models, hardware and scaling" : "Modely, hardware a škálování",
    icon: "tabler:cpu",
    text: en
      ? "We pick suitable models for your tasks and test them on your data. I work out what hardware you need for the output quality and request volume you require, and how that compares with paying for an API. I also show how to extend the solution once the request volume grows or a stronger model is needed."
      : "Vybereme vhodné modely pro vaše úlohy a vyzkoušíme je na vašich datech. Spočítám, jaký hardware je potřeba pro požadovanou kvalitu výstupů a objem požadavků a jak to vychází ve srovnání s platbami za API. Ukážu také, jak řešení rozšířit, až poroste objem požadavků nebo bude potřeba spustit silnější model.",
  },
  {
    id: "software",
    title: "Software",
    icon: "tabler:apps",
    text: en
      ? "I design an interface on top of the AI model and connect it to your existing systems. I build tools for specific tasks, such as searching your documents."
      : "Navrhnu rozhraní nad AI modelem a napojím ho na stávající systémy. Vytvořím nástroje pro konkrétní úlohy, například vyhledávání ve vašich dokumentech.",
  },
  {
    id: "bezpecnost",
    title: en ? "Maintenance and further development" : "Údržba a další rozvoj",
    icon: "tabler:shield-check",
    text: en
      ? "We plan regular maintenance of the system, model updates and further software development."
      : "Naplánujeme pravidelnou údržbu systému, aktualizace modelů a další vývoj softwaru.",
  },
];
---

<section class="section" aria-labelledby="spolu">
  <h2 id="spolu" class="title">
    {en ? "What we will work on" : "Detaily naší spolupráce"}
  </h2>
  <p class="lead">
    {
      en
        ? "When deploying a local AI solution, we will work on these areas:"
        : "Během nasazování lokálního AI řešení budeme řešit tyto oblasti:"
    }
  </p>

  <ol class="topics">
    {
      topics.map(topic => (
        <li class="topic">
          <span class="mark" aria-hidden="true">
            <Icon name={topic.icon} />
          </span>
          <div class="body">
            <h3 id={topic.id} class="topic-title">
              {topic.title}
            </h3>
            <p class="topic-text">{topic.text}</p>
            {topic.tiers && (
              <div class="tiers-wrap">
                <ol class="tiers">
                  {tiers.map(tier => (
                    <li class="tier">
                      <svg
                        class="icon"
                        viewBox="0 0 48 48"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <g class="ink" set:html={tier.icon} />
                      </svg>
                      <h4 class="name">{tier.title}</h4>
                      <p class="text">{tier.text}</p>
                    </li>
                  ))}
                </ol>
                <p class="scale">
                  <span class="end">
                    <Icon name="tabler:arrow-up" aria-hidden="true" />
                    {en ? "More guarantees" : "Více záruk"}
                  </span>
                  <span class="arrow" aria-hidden="true" />
                  <span class="end">
                    {en ? "Easier to use" : "Jednodušší použití"}
                    <Icon name="tabler:arrow-down" aria-hidden="true" />
                  </span>
                </p>
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .section {
    margin-block: 3.5rem;
  }
  .title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--accent-text);
    text-wrap: balance;
  }
  .lead {
    margin-bottom: 1.75rem;
    text-wrap: pretty;
  }

  /* one area after another, an icon on a line running down the left */
  .topic {
    --mark: 2.75rem;
    position: relative;
    display: grid;
    grid-template-columns: var(--mark) minmax(0, 1fr);
    column-gap: 1.1rem;
    padding-bottom: 2rem;
  }
  .topic:last-child {
    padding-bottom: 0;
  }
  .topic:not(:last-child)::before {
    content: "";
    position: absolute;
    top: var(--mark);
    bottom: 0;
    left: calc(var(--mark) / 2 - 1px);
    width: 2px;
    background: var(--accent);
    opacity: 0.35;
  }
  .mark {
    display: grid;
    place-items: center;
    width: var(--mark);
    height: var(--mark);
    border-radius: 50%;
    background: var(--accent);
    color: var(--background);
  }
  .mark :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  .body {
    padding-top: 0.55rem;
  }
  .topic-title {
    margin: 0 0 0.4rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--accent-text);
    scroll-margin-top: 5rem;
  }
  .topic-text {
    max-width: 65ch;
    text-wrap: pretty;
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.1rem;
  }
  .tier {
    display: flex;
    flex-direction: column;
    padding: 1rem 1rem 0.9rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--background), var(--accent) 7%);
  }
  .icon {
    --sw: 2.1;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.55rem;
    color: var(--accent-text);
  }
  .name {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--accent-text);
    text-wrap: balance;
  }
  .text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  /* one double-headed arrow under all four cards: more guarantees towards the left,
     easier use towards the right */
  .scale {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-text);
  }
  .end {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }
  /* the up/down arrows only make sense once the cards stack, on phones */
  .end :global(svg) {
    display: none;
    flex: none;
    width: 1.1em;
    height: 1.1em;
  }
  .arrow {
    position: relative;
    flex: 1;
    height: 2px;
    margin-inline: 9px;
    background: var(--accent);
  }
  .arrow::before,
  .arrow::after {
    content: "";
    position: absolute;
    top: 50%;
    border-block: 5px solid transparent;
    translate: 0 -50%;
  }
  .arrow::before {
    right: 100%;
    border-right: 9px solid var(--accent);
  }
  .arrow::after {
    left: 100%;
    border-left: 9px solid var(--accent);
  }

  @media (max-width: 900px) {
    .tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .section {
      margin-block: 2.75rem;
    }
    .topic {
      --mark: 2.25rem;
      column-gap: 0.8rem;
    }
    .mark :global(svg) {
      width: 1.15rem;
      height: 1.15rem;
    }
    .body {
      padding-top: 0.3rem;
    }
    /* the cards take the full width, over the line under the icon column */
    .tiers-wrap {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      margin-left: calc(-1 * (var(--mark) + 0.8rem));
    }
    .tiers {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0.6rem;
    }
    /* the cards stack, so the scale moves above them: up for guarantees, down for ease */
    .scale {
      order: -1;
      justify-content: space-between;
      margin: 1.1rem 0 0;
    }
    .arrow {
      display: none;
    }
    .end :global(svg) {
      display: block;
    }
    .tier {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.9rem;
      padding: 1rem;
    }
    .icon {
      grid-row: 1 / span 2;
      width: 2.6rem;
      height: 2.6rem;
    }
  }
</style>
