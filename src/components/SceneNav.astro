---
import { Icon } from "astro-icon/components";
import Figure from "./Figure.astro";
import { NAV, navHref, type Lang, type PageId } from "@/data/nav";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
  current?: PageId;
  /** Show each item's tagline under its label (front page). */
  taglines?: boolean;
  /** Pages to leave out; the grid narrows to the remaining figures. */
  hide?: PageId[];
  class?: string;
}

const {
  lang,
  current,
  taglines = false,
  hide = [],
  class: className,
} = Astro.props;
const items = NAV.filter(item => !hide.includes(item.id));
const t = useTranslations(lang);
---

<nav
  class:list={["scene-nav", className]}
  style={`--cols: ${items.length}`}
  aria-label={t("nav.main")}
>
  {
    items.map(item => (
      <a
        class="scene"
        href={navHref(item, lang)}
        aria-current={item.id === current ? "page" : undefined}
      >
        <Figure id={item.id} />
        <span class="scene-text">
          <span class="scene-label">
            {item.label[lang]}
            {item.href && (
              <Icon
                name="tabler:arrow-up-right"
                class="ext"
                aria-hidden="true"
              />
            )}
          </span>
          {taglines && <span class="scene-tagline">{item.tagline[lang]}</span>}
        </span>
      </a>
    ))
  }
</nav>
