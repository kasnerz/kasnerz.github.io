---
import SubpageLayout from "../layouts/SubpageLayout.astro";
import BusinessDetails from "./BusinessDetails.astro";
import ContactCta from "./ContactCta.astro";
import LinkButton from "./LinkButton.astro";
import LocalAiInstitutions from "./LocalAiInstitutions.astro";
import LocalAiScope from "./LocalAiScope.astro";
import LocalAiUses from "./LocalAiUses.astro";
import { SPOTS } from "@/data/figures";
import { getNavItem, navHref } from "@/data/nav";

interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;

type Step = { art: keyof typeof SPOTS; title: string; text: string };
// `why` is HTML, one bullet each, for the links. The blog bullet with its screenshot follows
// them in the markup, starting with `blog`.
type Copy = {
  heading: string;
  lead: string;
  steps: Step[];
  whyTitle: string;
  why: string[];
  blog: string;
};

const copies: Record<"cs" | "en", Copy> = {
  en: {
    heading: "How I can help you",
    lead: "I can guide you through the whole process of <b>deploying a local AI solution</b> built on open-weight AI models (such as Qwen, Gemma, DeepSeek, Nemotron…) and hardware running right on your premises (a GPU server, an AI workstation…).<p>You decide the scope of our collaboration: it can be just one or a few consultations, or a long-term collaboration on rolling out the whole system.</p><p>A long-term collaboration can look like this, for example:</p>",
    steps: [
      {
        art: "talk",
        title: "Initial consultation",
        text: "We discuss how you want to use AI and whether a local AI solution makes sense for you. <i>The initial consultation is free of charge.</i>",
      },
      {
        art: "strategy",
        title: "Solution design",
        text: "Within 1–3 weeks, I prepare a strategy for the solution. I present suitable hardware, models and options for connecting your tools.",
      },
      {
        art: "deploy",
        title: "Deploying AI models",
        text: "I set up an inference server with AI models, connect your tools to it and prepare the documentation.",
      },
      {
        art: "workshop",
        title: "Team training",
        text: "I teach your team to work with the new solution. I explain its benefits, limits, risks and possibilities.",
      },
      {
        art: "upkeep",
        title: "Maintenance",
        text: "I remain available to update the models, scale the hardware or implement new tools.",
      },
    ],
    whyTitle: "Why me?",
    why: [
      `I hold a PhD in language model <a href="${navHref(getNavItem("research"), "en")}">research</a> and have years of experience in the field.`,
      "I'm a freelancer: dealing with me is more straightforward than with a large company.",
      "I use AI models every day in my own work.",
    ],
    blog: "I write a blog and a newsletter about open-weight AI models (in Czech) at",
  },
  cs: {
    heading: "Jak vám mohu pomoci",
    lead: "Dokážu vás provést celým procesem <b>nasazení lokálního AI řešení</b> postaveného na otevřených AI modelech (jako Qwen, Gemma, DeepSeek, Nemotron…) a hardwaru běžícím přímo u vás (GPU server, AI pracovní stanice…).<p>Rozsah naší spolupráce určujete sami: může jít pouze o jednu nebo několik konzultací, ale také o dlouhodobou spolupráci na zavedení celého systému.</p><p>Naše dlouhodobá spolupráce může vypadat například takto:</p>",
    steps: [
      {
        art: "talk",
        title: "Úvodní konzultace",
        text: "Probereme, jak chcete používat AI a jestli má lokální AI řešení pro vás smysl. <i>Úvodní konzultace je zdarma.</i>",
      },
      {
        art: "strategy",
        title: "Návrh řešení",
        text: "Během 1–3 týdnů připravím strategii řešení. Představím vám vhodný hardware, modely a možnosti napojení vašich nástrojů.",
      },
      {
        art: "deploy",
        title: "Nasazení AI modelů",
        text: "Zprovozním inferenční server s AI modely, napojím na ně vaše nástroje a připravím dokumentaci.",
      },
      {
        art: "workshop",
        title: "Školení týmu",
        text: "Naučím váš tým s novým řešením pracovat. Vysvětlím jeho přínosy, omezení, rizika a možnosti.",
      },
      {
        art: "upkeep",
        title: "Údržba",
        text: "Budu k dispozici pro aktualizaci modelů, škálování hardwaru nebo implementaci nových nástrojů.",
      },
    ],
    whyTitle: "Proč já?",
    why: [
      `Mám titul PhD z <a href="${navHref(getNavItem("research"), "cs")}">výzkumu</a> jazykových modelů a dlouhodobé zkušenosti v tomto oboru.`,
      "Jsem freelancer: jednání se mnou je přímočařejší než s velkou firmou.",
      "AI modely používám každý den při vlastní práci.",
    ],
    blog: "O otevřených AI modelech píšu blog a newsletter na webu",
  },
};
const copy = copies[lang];
---

<SubpageLayout lang={lang} page="consulting">
  <section class="mb-8" aria-labelledby="nasazeni">
    <h2 id="nasazeni" class="section-title">{copy.heading}</h2>
    <div class="lead" set:html={copy.lead} />
  </section>

  <ol class="timeline">
    {
      copy.steps.map((step, i) => (
        <li class="tl-step">
          <svg
            class="spot"
            viewBox="0 0 200 160"
            aria-hidden="true"
            focusable="false"
          >
            <g class="ink" set:html={SPOTS[step.art]} />
          </svg>
          <span class="tl-mark" aria-hidden="true">
            <span class="tl-num">{i + 1}</span>
          </span>
          <div class="tl-body">
            <h3 class="step-title">{step.title}</h3>
            <p set:html={step.text} />
          </div>
        </li>
      ))
    }
  </ol>

  <LocalAiUses lang={lang} />
  <LocalAiInstitutions lang={lang} />
  <LocalAiScope lang={lang} />

  <section class="closing" aria-labelledby="why-title">
    <h2 id="why-title" class="section-title">{copy.whyTitle}</h2>
    <ul class="why">
      {copy.why.map(point => <li set:html={point} />)}
      <li>
        {copy.blog}{" "}
        <LinkButton icon="tabler:cpu" href="https://lokalni.ai">
          Lokální.AI
        </LinkButton>
        :
        <a
          href="https://lokalni.ai"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 mb-2 block max-w-md overflow-hidden rounded-xl border border-border hover:border-accent"
        >
          <img
            src="/projects/lokalni-ai.png"
            alt="Lokální.AI"
            width="1200"
            height="630"
            class="h-auto w-full"
            loading="lazy"
          />
        </a>
      </li>
    </ul>
    <BusinessDetails lang={lang} />
    <ContactCta lang={lang} class="cta-dark" />
  </section>
</SubpageLayout>

<style>
  .section-title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--accent-text);
  }
  .lead :global(p) {
    margin-top: 1rem;
  }
  /* ---------- the five steps, left to right ---------- */
  .timeline {
    --gap: 1rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gap);
    text-align: center;
  }
  .tl-step {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .tl-step .spot {
    --sw: 4;
    width: 100%;
    max-width: 112px;
    height: auto;
    color: var(--accent);
  }
  /* the numbered stop, and the line running through all of them */
  .tl-mark {
    position: relative;
    align-self: stretch;
    display: flex;
    justify-content: center;
    margin: 0.6rem 0 0.75rem;
  }
  .tl-mark::before {
    content: "";
    position: absolute;
    top: 50%;
    left: calc(var(--gap) / -2);
    right: calc(var(--gap) / -2);
    height: 2px;
    margin-top: -1px;
    background: var(--accent);
    opacity: 0.35;
  }
  .tl-step:first-child .tl-mark::before {
    left: 50%;
  }
  .tl-step:last-child .tl-mark::before {
    right: 50%;
  }
  .tl-num {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--background);
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .step-title {
    margin: 0 0 0.3rem;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--accent-text);
    text-wrap: balance;
  }
  .tl-body p {
    font-size: 0.92rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .why :global(a:not([class])) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---------- why me, and the button ---------- */
  .closing {
    margin-top: 3.5rem;
  }
  .closing :global(.cta-dark) {
    background: var(--accent);
    color: var(--background);
  }
  .closing :global(.cta-dark:hover) {
    background: color-mix(in oklab, var(--accent), var(--foreground) 22%);
  }
  .why {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
    list-style: disc;
    text-wrap: pretty;
  }
  .why li + li {
    margin-top: 0.35rem;
  }
  .why li::marker {
    color: var(--accent);
  }

  /* ---------- narrower screens ---------- */
  @media (max-width: 820px) {
    /* the steps run down instead, each beside its picture */
    .timeline {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      text-align: left;
    }
    .tl-step {
      display: grid;
      grid-template-columns: 1.9rem 84px minmax(0, 1fr);
      column-gap: 0.9rem;
      align-items: start;
      padding-bottom: 1.25rem;
    }
    .tl-step .spot {
      --sw: 4.4;
      grid-column: 2;
      grid-row: 1;
    }
    .tl-mark {
      grid-column: 1;
      grid-row: 1;
      align-self: stretch;
      margin: 0;
    }
    .tl-mark::before {
      top: 0;
      bottom: -1.25rem;
      left: 50%;
      right: auto;
      width: 2px;
      height: auto;
      margin: 0 0 0 -1px;
    }
    .tl-step:first-child .tl-mark::before {
      top: 0.95rem;
      left: 50%;
    }
    .tl-step:last-child .tl-mark::before {
      bottom: auto;
      height: 0.95rem;
      right: auto;
    }
    .tl-body {
      grid-column: 3;
      grid-row: 1;
      padding-top: 0.2rem;
    }
  }
</style>
