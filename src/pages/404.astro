---
import SubpageLayout from "@/layouts/SubpageLayout.astro";
import LinkButton from "@/components/LinkButton.astro";
import { useTranslations, getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SubpageLayout lang={lang} title="404" subtitle={t("404.title")}>
  <div class="flex flex-col items-center py-10 text-center">
    <span aria-hidden="true" class="text-2xl">¯\_(ツ)_/¯</span>
    <LinkButton
      id="home-link"
      href={lang === "en" ? "/" : "/cs/"}
      class="my-6 text-lg underline decoration-dashed underline-offset-8"
    >
      {t("404.button")}
    </LinkButton>
  </div>
</SubpageLayout>

<script>
  // Client-side fix for 404 page content if served statically at root for subpaths
  import { ui } from "@/i18n/ui";

  const pathname = window.location.pathname;
  const isCzech = pathname.startsWith("/cs/") || pathname === "/cs";

  if (isCzech) {
    const titleEl = document.querySelector(".stage-sub");
    const btnEl = document.querySelector("#home-link");

    if (titleEl && ui.cs["404.title"]) {
      titleEl.textContent = ui.cs["404.title"];
    }
    if (btnEl && ui.cs["404.button"]) {
      btnEl.textContent = ui.cs["404.button"];
      btnEl.setAttribute("href", "/cs/");
    }
  }
</script>
