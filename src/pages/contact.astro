---
import { Icon } from "astro-icon/components";
import { SOCIALS } from "../constants";
import LinkButton from "@/components/LinkButton.astro";
import { useTranslations } from "@/i18n/utils";

import SubpageLayout from "@/layouts/SubpageLayout.astro";

const t = useTranslations("en");
---

<SubpageLayout
  lang="en"
  title={t("tools.contact")}
  subtitle={t("contact.subtitle")}
>
  <section id="contact" class="app-prose mb-8 max-w-none">
    <p>
      Are you interested in me professionally? Have a look at <LinkButton
        href="/cv.pdf"
        icon="tabler:file-text">my CV</LinkButton
      >.
    </p>

    <p>You can also find me on these sites:</p>

    <ul class="list-none pl-0">
      {
        SOCIALS.map(social => (
          <li class="my-2 flex -translate-x-1.5 items-start gap-1">
            <Icon
              name={social.icon}
              class="text-skin-accent inline-block h-[1.3em] w-[1.3em] flex-shrink-0 translate-y-1 align-text-bottom"
            />
            <span>
              <a
                href={social.href}
                class="group ml-1 inline-flex items-baseline gap-1 underline decoration-dashed underline-offset-6"
              >
                {social.name}
              </a>{" "}
              – {social.description}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</SubpageLayout>
